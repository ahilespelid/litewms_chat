APP_NAME="LiteWMS Chat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chat.litewms.ru
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=litewms_chat
DB_USERNAME=litewms_chat
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Сессий и cookie у чата нет (только Bearer-токены), поэтому SESSION_DRIVER=array.
SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reverb (WebSocket). Сервер слушает 8080 внутри сети; браузеры ходят на wss://chat.litewms.ru/app/*
REVERB_APP_ID=litewms-chat
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_CLIENT_HOST=chat.litewms.ru
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https

# Браузерные push-уведомления: php artisan chat:vapid
VAPID_SUBJECT=mailto:admin@litewms.ru
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Необязательные настройки
CHAT_HANDOFF_MAX_AGE=600
CHAT_TOKEN_TTL_DAYS=7
CHAT_MAX_TOKENS=10
CHAT_FILE_MAX_KB=25600
OCTANE_WORKERS=auto
